FROM node:20-bullseye

# psql for Claude's Bash tool to query the read-only DB role.
# python + pandas/matplotlib for ad-hoc analysis.
# jq for shaping JSON in shell pipelines.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql-client \
      python3 \
      python3-pip \
      jq \
      libsdl2-dev \
 && pip3 install --no-cache-dir \
      pandas \
      matplotlib \
      tabulate \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI, so Claude's Bash tool can explore Scott's repos the same way it
# explores the DB: read-only, bounded by the credential rather than the tools.
# gh picks up GH_TOKEN from the environment automatically.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Make plain `git clone https://github.com/<owner>/<repo>` work for PRIVATE
# repos without the agent ever handling the token itself. The helper reads
# GH_TOKEN at call time, so no credential is baked into the image layer.
RUN git config --system credential.https://github.com.helper \
      '!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'

WORKDIR /usr/src/app

# Data Boy has its own package.json to avoid peer-dep conflicts with
# the other bots' openai dependency (which pins zod@3, while the
# Agent SDK requires zod@4).
COPY package-data-boy.json ./package.json
RUN npm install --omit=dev

# Patch the Gemini provider to bypass Gemini 3.x's mandatory thoughtSignature
# on functionCall parts. See patch-gemini-provider.js for details.
COPY patch-gemini-provider.js ./
RUN node patch-gemini-provider.js

COPY data-boy.js data-boy-prompt.md code-prompt.md toaster-feature.js feature-prompt.md job-queue.js ./

# Scratch dir Claude works in. Wiped per query by data-boy.js.
RUN mkdir -p /tmp/data-boy-work

# Persistent clone cache. Cloning lumen on every question would be slow, so
# repos live here across queries and are `git -C <dir> pull`ed when stale.
# NOT wiped per query, unlike /tmp/data-boy-work. Backed by a named volume.
RUN mkdir -p /var/cache/repos

CMD ["node", "data-boy.js"]
